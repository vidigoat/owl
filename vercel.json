{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "{public,data/admitted}/**"
    },
    "api/[...path].js": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "{public,data/admitted}/**"
    },
    "api/mcp.js": {
      "memory": 512,
      "maxDuration": 60,
      "includeFiles": "{public,data/admitted,manual}/**"
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    }
  ]
}
