    "51:clean drain pump": {
      "reference": "Clean the Drain pump, Page 51",
      "heading": "Clean drain pump",
      "pages": [
        51
      ],
      "steps": [
        {
          "n": 1,
          "text": "Disconnect the appliance from the power supply.",
          "page": 51
        },
        {
          "n": 2,
          "text": "Remove the upper and lower rack.",
          "page": 51
        },
        {
          "n": 3,
          "text": "Remove the filter system.",
          "page": 51
        },
        {
          "n": 4,
          "text": "Scoop out any water.",
          "notes": [
            "Use a sponge if necessary."
          ],
          "page": 51
        },
        {
          "n": 5,
          "text": "Pry the pump cover off using a spoon and grip it by the crosspiece.",
          "page": 51
        },
        {
          "n": 6,
          "text": "Lift the pump cover diagonally inward and take it out.",
          "notes": [
            "Now you can reach the impeller with your hand."
          ],
          "page": 51
        },
        {
          "n": 7,
          "text": "Remove any food remnants or foreign objects in the area of the impeller.",
          "page": 51
        },
        {
          "n": 8,
          "text": "Insert the pump cover and press down.",
          "notes": [
            "The pump cover clicks into position."
          ],
          "page": 51
        },
        {
          "n": 9,
          "text": "Install the filter system.",
          "page": 51
        },
        {
          "n": 10,
          "text": "Insert the upper and lower rack.",
          "page": 51
        },
        {
          "n": 11,
          "text": "Connect the appliance to the power supply.",
          "page": 51
        }
      ]
    }
  }
